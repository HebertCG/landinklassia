<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const reducedMotion = motionPreference.matches;
  const revealTargets = new Set<HTMLElement>();

  const addReveal = (element: Element | null, direction = 'up', delay = 0) => {
    if (!(element instanceof HTMLElement) || revealTargets.has(element)) return;
    element.dataset.reveal = direction;
    element.style.setProperty('--reveal-delay', `${delay}ms`);
    revealTargets.add(element);
  };

  document.querySelectorAll<HTMLElement>(
    '.section-head, .sub-hero-copy, .photo-hero .sub-hero-copy, .legal-hero .legal-shell, .principles, .compare, .cta-card, .about-hero-copy, .about-hero-photo, .about-impact-copy, .about-impact-photo, .connection-statement, .tour-heading, .modules-heading, .pocket-heading, .pocket-copy, .live-copy, .live-product, .made-layout, .trust-layout, .closing-scene h2'
  ).forEach((item) => addReveal(item));

  document.querySelectorAll<HTMLElement>('.feature-row').forEach((row) => {
    const children = Array.from(row.children);
    addReveal(children[0] ?? null, 'left');
    addReveal(children[1] ?? null, 'right', 90);
  });

  document.querySelectorAll<HTMLElement>('.story-grid').forEach((row) => {
    const children = Array.from(row.children);
    addReveal(children[0] ?? null, 'left');
    addReveal(children[1] ?? null, 'right', 90);
  });

  const staggeredGroups = [
    '.module-grid', '.stats', '.steps', '.security-grid', '.alt-grid', '.capability-grid',
    '.module-nav', '.replaces', '.footer-grid', '.about-values', '.fact-line'
  ];

  staggeredGroups.forEach((selector) => {
    document.querySelectorAll<HTMLElement>(selector).forEach((group) => {
      Array.from(group.children).forEach((item, index) => addReveal(item, 'up', Math.min(index, 5) * 70));
    });
  });

  document.querySelectorAll<HTMLElement>('.legal-content > *').forEach((item, index) =>
    addReveal(item, 'up', (index % 3) * 45)
  );

  document.documentElement.classList.add('motion-ready');

  if (reducedMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((item) => item.dataset.revealed = 'true');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.revealed = 'true';
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -7% 0px' }
    );
    revealTargets.forEach((item) => observer.observe(item));
  }

  const heroScene = document.querySelector<HTMLElement>('[data-hero-scene]');
  const phoneScene = document.querySelector<HTMLElement>('[data-phone-scene]');
  const connection = document.querySelector<HTMLElement>('[data-brand-scene]');
  let ticking = false;
  const updateMotion = () => {
    if (!motionPreference.matches) {
      if (heroScene && heroScene.getBoundingClientRect().bottom > 0) {
        heroScene.style.setProperty('--hero-shift', `${-Math.min(window.scrollY * 0.30, 240)}px`);
        heroScene.style.setProperty('--art-shift', `${-Math.min(window.scrollY * 0.035, 28)}px`);
        heroScene.style.setProperty('--art-turn', `${Math.min(window.scrollY * 0.003, 2)}deg`);
        heroScene.style.setProperty('--decor-turn', `${window.scrollY * 0.08 + 12}deg`);
      }
      if (phoneScene) {
        const rect = phoneScene.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          const phase = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
          phoneScene.style.setProperty('--phone-turn', `${phase * 18 - 12}deg`);
        }
      }
      if (connection) {
        const rect = connection.getBoundingClientRect();
        if (rect.top < innerHeight && rect.bottom > 0) {
          const phase = Math.min(1, Math.max(0, (innerHeight - rect.top) / (innerHeight + rect.height)));
          connection.style.setProperty('--logo-turn', `${phase * 12 - 6}deg`);
          connection.style.setProperty('--logo-rise', `${16 - phase * 32}px`);
        }
      }
    }
    ticking = false;
  };
  const requestMotion = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateMotion);
  };
  updateMotion();
  window.addEventListener('scroll', requestMotion, { passive: true });
  window.addEventListener('resize', requestMotion, { passive: true });
  motionPreference.addEventListener('change', () => {
    ['--hero-shift', '--art-shift', '--art-turn', '--decor-turn'].forEach((name) => heroScene?.style.removeProperty(name));
    phoneScene?.style.removeProperty('--phone-turn');
    ['--logo-turn', '--logo-rise'].forEach((name) => connection?.style.removeProperty(name));
    if (motionPreference.matches) revealTargets.forEach((item) => item.dataset.revealed = 'true');
    requestMotion();
  });
</script>
