---
import { WHATSAPP_URL } from '../config/contact';
// Inclusive through December 31 in Peru (UTC-05:00), independent of visitor timezone.
const endsAt = '2027-01-01T00:00:00-05:00';
---
<aside class="pricing-promo" data-promotion data-ends-at={endsAt} aria-labelledby="promotion-title">
  <div class="promo-copy">
    <p class="promo-kicker">EL GRAN SALTO A KLASSIA</p>
    <h3 id="promotion-title">Tu academia. Todas las posibilidades.</h3>
    <div data-promo-active hidden>
      <p class="promo-offer">Plan Profesional <strong>totalmente gratis.</strong></p>
      <p class="promo-date">Hasta el <time datetime="2026-12-31">31 de diciembre de 2026</time>, inclusive. Hora de Perú.</p>
      <a class="promo-cta" href={WHATSAPP_URL} target="_blank" rel="noreferrer">Quiero dar el salto <span aria-hidden="true">↗</span></a>
    </div>
    <p data-promo-ended hidden>La promoción gratuita del Plan Profesional terminó el 31 de diciembre de 2026. Conoce los planes disponibles a continuación.</p>
    <p data-promo-fallback>Promoción del Plan Profesional gratis con vigencia hasta el 31 de diciembre de 2026, inclusive (hora de Perú). <a href={WHATSAPP_URL} target="_blank" rel="noreferrer">Consulta su disponibilidad.</a></p>
  </div>
  <div class="promo-clock" data-promo-clock hidden>
    <p class="promo-clock-label" data-promo-clock-label>Tiempo que queda para disfrutarlo gratis</p>
    <dl class="promo-digits" role="timer" aria-live="off" aria-label="Tiempo restante de la promoción">
      <div><dt>Días</dt><dd data-promo-days>00</dd></div>
      <div><dt>Horas</dt><dd data-promo-hours>00</dd></div>
      <div><dt>Minutos</dt><dd data-promo-minutes>00</dd></div>
      <div><dt>Segundos</dt><dd data-promo-seconds>00</dd></div>
    </dl>
    <p class="promo-clock-note" data-promo-note>El Plan Profesional sin costo hasta fin de año.</p>
  </div>
</aside>
<script>
  const promotion = document.querySelector<HTMLElement>('[data-promotion]');
  if (promotion) {
    const deadline = Date.parse(promotion.dataset.endsAt ?? '');
    const active = promotion.querySelector<HTMLElement>('[data-promo-active]');
    const ended = promotion.querySelector<HTMLElement>('[data-promo-ended]');
    const fallback = promotion.querySelector<HTMLElement>('[data-promo-fallback]');
    const clock = promotion.querySelector<HTMLElement>('[data-promo-clock]');
    const label = promotion.querySelector<HTMLElement>('[data-promo-clock-label]');
    const note = promotion.querySelector<HTMLElement>('[data-promo-note]');
    const fields = ['days', 'hours', 'minutes', 'seconds'].map(unit =>
      promotion.querySelector<HTMLElement>(`[data-promo-${unit}]`));
    if (Number.isFinite(deadline) && active && ended && fallback && clock && label && note) {
      let interval: ReturnType<typeof setInterval> | undefined;
      const update = (): void => {
        const seconds = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
        const values = [Math.floor(seconds / 86400), Math.floor(seconds % 86400 / 3600), Math.floor(seconds % 3600 / 60), seconds % 60];
        fields.forEach((field, index) => {
          const value = String(values[index] ?? 0).padStart(2, '0');
          if (field && field.textContent !== value) field.textContent = value;
        });
        const expired = seconds === 0;
        active.hidden = expired;
        ended.hidden = !expired;
        promotion.dataset.expired = String(expired);
        label.textContent = expired ? 'Promoción finalizada' : 'Tiempo que queda para disfrutarlo gratis';
        note.hidden = expired;
        if (expired && interval !== undefined) clearInterval(interval);
      };
      update();
      fallback.hidden = true;
      clock.hidden = false;
      if (Date.now() < deadline) interval = setInterval(update, 1000);
      // Recalculate from the deadline when returning to a suspended tab; never decrement a stale value.
      document.addEventListener('visibilitychange', update);
      window.addEventListener('pageshow', update);
    }
  }
</script>

<style>
  .pricing-promo { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; padding: 32px 36px; margin-bottom: 34px; border-radius: 24px; background: #142e37; color: #fffef7; }
  .promo-kicker { font-size: .64rem; font-weight: 800; letter-spacing: .13em; color: #d9fa68; margin-bottom: 12px; }
  .promo-copy h3 { font-size: clamp(1.6rem, 2.2vw, 2.15rem); line-height: 1.12; color: #fffef7; }
  .promo-offer { font-size: 1rem; margin-top: 12px; color: #fffef7; }
  .promo-offer strong { color: #a5e8fa; }
  .promo-date { font-size: .75rem; color: #c4d9dd; margin-top: 8px; }
  .promo-cta { display: inline-flex; align-items: center; gap: 20px; margin-top: 20px; font-size: .8rem; font-weight: 750; background: #d9fa68; color: #142e37; border-radius: 24px; padding: 11px 18px; min-height: 44px; }
  .promo-cta span { font-size: 22px; }
  .promo-clock-label { color: #c4d9dd; font-size: .8rem; margin-bottom: 14px; }
  .promo-digits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 0; }
  .promo-digits > div { display: flex; flex-direction: column-reverse; align-items: center; gap: 10px; background: #25444d; border: 1px solid #50727a; border-radius: 14px; padding: 20px 8px 16px; }
  .promo-digits dt { font-size: .65rem; color: #c4d9dd; }
  .promo-digits dd { margin: 0; font-size: clamp(1.6rem, 3.3vw, 3.2rem); font-weight: 650; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.04em; }
  .promo-digits > div:last-child dd { color: #a5e8fa; }
  .promo-clock-note { margin-top: 12px; font-size: .72rem; color: #c4d9dd; }
  [data-promo-ended], [data-promo-fallback] { font-size: .85rem; color: #c4d9dd; margin-top: 12px; }
  [data-promo-fallback] a { text-decoration: underline; }
  @media (max-width: 900px) { .pricing-promo { grid-template-columns: 1fr; gap: 28px; } .promo-clock { max-width: 500px; width: 100%; } }
  @media (max-width: 520px) {
    .pricing-promo { padding: 26px 20px; border-radius: 20px; }
    .promo-digits { gap: 6px; }
    .promo-digits > div { padding: 15px 3px 12px; border-radius: 10px; }
    .promo-digits dt { font-size: .6rem; }
    .promo-date { line-height: 1.65; }
  }
</style>
