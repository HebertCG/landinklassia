---
import { WHATSAPP_URL, TIKTOK_URL, INSTAGRAM_URL, FACEBOOK_URL } from '../config/contact';
---

<div class="social-float" data-social-float>
  <a class="social-link social-tiktok" href={TIKTOK_URL} target="_blank" rel="noreferrer" aria-label="Klassia en TikTok">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6c0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64c0 3.33 2.76 5.7 5.69 5.7c3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg>
  </a>
  <a class="social-link social-instagram" href={INSTAGRAM_URL} target="_blank" rel="noreferrer" aria-label="Klassia en Instagram">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
  </a>
  <a class="social-link social-facebook" href={FACEBOOK_URL} target="_blank" rel="noreferrer" aria-label="Klassia en Facebook">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
  </a>
  <a class="whatsapp-float" href={WHATSAPP_URL} target="_blank" rel="noreferrer" aria-label="Conversar con Klassia por WhatsApp">
    <span class="whatsapp-label" aria-hidden="true">¿Hablamos por WhatsApp?</span>
    <span class="whatsapp-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" role="img">
        <path
          fill="currentColor"
          d="M16.04 3.2A12.65 12.65 0 0 0 5.35 22.62L3.2 28.8l6.39-2.06a12.71 12.71 0 1 0 6.45-23.54Zm0 22.14a9.43 9.43 0 0 1-4.81-1.32l-.46-.27-3.79 1.22 1.25-3.69-.3-.48a9.42 9.42 0 1 1 8.11 4.54Zm5.17-7.06c-.28-.14-1.67-.82-1.93-.92-.26-.09-.45-.14-.64.14-.19.28-.73.92-.9 1.11-.16.19-.33.21-.61.07-.28-.14-1.19-.44-2.27-1.4a8.48 8.48 0 0 1-1.57-1.95c-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.5-.07-.14-.64-1.54-.87-2.11-.23-.55-.47-.48-.64-.49h-.54c-.19 0-.5.07-.76.35-.26.28-1 1-1 2.44s1.03 2.83 1.17 3.02c.14.19 2.03 3.1 4.91 4.34.69.3 1.22.47 1.64.6.69.22 1.31.19 1.81.12.55-.08 1.67-.68 1.9-1.34.24-.66.24-1.23.17-1.34-.07-.12-.26-.19-.54-.33Z"
        />
      </svg>
    </span>
  </a>
</div>
