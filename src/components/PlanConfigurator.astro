---
import { plans, storageOptions, number } from '../data/plans';
import { WHATSAPP_URL } from '../config/contact';
---
<section class="plan-config-section" id="configura" aria-labelledby="config-title">
  <div class="container plan-config-layout">
    <div><p class="eyebrow">A TU MEDIDA</p><h2 id="config-title">Tu plan.<br /><em>Un poco más de espacio.</em></h2><p>Todos los planes incluyen almacenamiento. Si necesitas más, elige una ampliación y revisa tu total mensual antes de conversar con nosotros.</p><p class="storage-rates">+100 GB · <b>S/25 al mes</b><br />+500 GB · <b>S/99 al mes</b></p></div>
    <div class="plan-config" data-plan-config data-contact={WHATSAPP_URL} hidden>
      <label class="config-label" for="config-plan">1. Elige tu plan</label>
      <select id="config-plan" name="plan">{plans.map(plan => <option value={plan.id}>{plan.name} · {plan.from ? 'desde ' : ''}S/{plan.price}/mes</option>)}</select>
      <fieldset><legend>2. Almacenamiento adicional</legend><div class="storage-options">{storageOptions.map((option, i) => <label><input type="radio" name="storage" value={option.id} checked={i === 0} /><span>{option.label}<small>{option.price ? `+ S/${option.price}/mes` : 'Sin costo adicional'}</small></span></label>)}</div></fieldset>
      <div class="config-summary" aria-live="polite" aria-atomic="true">
        <p data-config-description>Plan Inicial · Hasta {number(100)} alumnos activos</p>
        <p data-config-storage>100 GB de almacenamiento total</p>
        <div class="config-total"><span>Total mensual</span><strong data-config-total>S/149<span>/mes</span></strong></div>
        <p class="config-breakdown" data-config-breakdown>Plan S/149 + almacenamiento adicional S/0</p>
      </div>
      <a class="button button-primary" data-config-contact href={WHATSAPP_URL} target="_blank" rel="noreferrer">Consultar mi selección <span class="button-arrow" aria-hidden="true">↗</span></a>
      <p class="config-help">Te lleva a WhatsApp con tu selección. No realiza ningún cobro.</p>
    </div>
    <noscript><div class="config-nojs"><p>Puedes elegir tu plan y solicitar 100 GB o 500 GB adicionales al conversar con nuestro equipo.</p><a class="button button-primary" href={WHATSAPP_URL} target="_blank" rel="noreferrer">Consultar plan y almacenamiento</a></div></noscript>
  </div>
</section>
<script>
  import { plans, storageOptions, number, storageLabel } from '../data/plans';
  const config = document.querySelector<HTMLElement>('[data-plan-config]');
  const select = document.querySelector<HTMLSelectElement>('#config-plan');
  const contact = config?.querySelector<HTMLAnchorElement>('[data-config-contact]');
  if (config && select && contact && config.dataset.contact) {
    const contactBase = config.dataset.contact;
    const params = new URLSearchParams(location.search);
    const requested = plans.find(plan => plan.id === params.get('plan'));
    if (requested) select.value = requested.id;
    const update = (): void => {
      const plan = plans.find(item => item.id === select.value);
      const chosen = config.querySelector<HTMLInputElement>('input[name="storage"]:checked');
      const storage = storageOptions.find(item => item.id === chosen?.value);
      if (!plan || !storage) return;
      const total = `${plan.from ? 'Desde ' : ''}S/${number(plan.price + storage.price)}`;
      const description = config.querySelector('[data-config-description]');
      const capacity = config.querySelector('[data-config-storage]');
      const amount = config.querySelector('[data-config-total]');
      const breakdown = config.querySelector('[data-config-breakdown]');
      if (description) description.textContent = `Plan ${plan.name} · Hasta ${number(plan.students)} alumnos activos`;
      if (capacity) capacity.textContent = `${storageLabel(plan.storageGB + storage.gb)} de almacenamiento total`;
      if (amount) amount.textContent = `${total}/mes`;
      if (breakdown) breakdown.textContent = `Plan ${plan.from ? 'desde ' : ''}S/${plan.price} + almacenamiento adicional S/${storage.price}`;
      const url = new URL(contactBase);
      url.searchParams.set('text', `Hola, me interesa el Plan ${plan.name} de Klassia para hasta ${number(plan.students)} alumnos activos. Almacenamiento adicional: ${storage.label}. Total mensual: ${total}. Quisiera más información.`);
      contact.href = url.href;
    };
    config.addEventListener('change', update);
    document.querySelectorAll<HTMLAnchorElement>('[data-select-plan]').forEach(link => {
      link.addEventListener('click', event => {
        const plan = plans.find(item => item.id === link.dataset.selectPlan);
        if (!plan) return;
        event.preventDefault(); select.value = plan.id; update();
        document.getElementById('configura')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        select.focus({ preventScroll: true });
      });
    });
    update(); config.hidden = false;
  }
</script>
